# Redis/Celery work, step 8.5: settings for the Docker setup (docker-compose.yml).
# Copy this file to .env.docker in the same folder and change the values.
# NEVER commit .env.docker (it is in .gitignore).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Multi-college: every college has its own address (abc.localhost ...)
DJANGO_ALLOWED_HOSTS=.localhost,localhost,127.0.0.1
DJANGO_CORS_ORIGIN_REGEXES=^http://([a-z0-9]+\.)?localhost:5173$
DJANGO_CSRF_TRUSTED_ORIGINS=http://*.localhost:5173
COLLEGE_DOMAIN_SUFFIX=localhost
ENABLED_MODULES=all

# Database the backend uses (inside Docker the host is "db")
DB_NAME=kbtech_campus_docker
DB_USER=lms
DB_PASSWORD=change-me-db-password

# The PostgreSQL container creates this database/user on first start.
# Keep them the SAME as DB_NAME / DB_USER / DB_PASSWORD above.
POSTGRES_DB=kbtech_campus_docker
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-db-password

# Email (leave empty for a local test: nothing is sent)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
